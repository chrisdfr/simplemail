{
    "name": "chrisdfr/simplemail",
    "description": "Simplifie l'utilisation et l'envoie d'un message avec PHPMailer",
    "type": "library",
    "keywords": ["mail", "mailer", "phpmailer"],
    "require": {
        "phpmailer/phpmailer": "^6.9"
    },
    "license": "LGPL-2.1-only",
    "autoload": {
        "psr-4": {
            "ChrisDfr\\Simplemail\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Christophe Dufour",
            "email": "chrisdfr@proximus.be"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [{
        "name": "package",
        "type": "path",
        "url": "/home/christophe/dev/php/configjson"
    }],
    "require-dev": {
        "chrisdfr/configjson": "@dev"
    }
}
